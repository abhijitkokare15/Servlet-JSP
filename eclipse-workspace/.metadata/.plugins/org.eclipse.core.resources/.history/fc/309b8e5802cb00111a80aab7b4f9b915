
import java.sql.*;

public class DbDao {

    public boolean check(String name, String password) {
    	 Connection con;
    	  PreparedStatement ps;
    	  ResultSet  rs;
    	  
    	try
    	{
        String qr = "SELECT * FROM login WHERE name = ? AND password = ?";

        Class.forName("com.mysql.cj.jdbc.Driver");

         con = DriverManager.getConnection("jdbc:mysql://localhost:3306/studentdb", "root", "");

        ps = con.prepareStatement(qr);

        ps.setString(1, name);
        ps.setString(2, password);

         rs = ps.executeQuery();

        if (rs.next()) {
            return true;
        }
        
    	}
    	
    	catch(Exception e)
    	{
    		e.printStackTrace();
    	}
    	
    	finally
    	{
    		rs.close();
    		ps.close();
    		con.close();
    	}

        return false;
    }
}


import java.sql.*;

public class DbDao {

    public boolean check(String name, String password) {
        Connection con = null;
        PreparedStatement ps = null;
        ResultSet rs = null;

        try {
            String qr = "SELECT * FROM login WHERE name = ? AND password = ?";

            Class.forName("com.mysql.cj.jdbc.Driver");

            con = DriverManager.getConnection(
                "jdbc:mysql://localhost:3306/studentdb", "root", "");

            ps = con.prepareStatement(qr);

            ps.setString(1, name);
            ps.setString(2, password);

            rs = ps.executeQuery();

            if (rs.next()) {
                return true;
            }

        } catch (Exception e) {
            e.printStackTrace();

        } finally {
            try {
                if (rs != null) 
                	rs.close();
                if (ps != null) 
                	ps.close();
                if (con != null) 
                	con.close();
            } 
            catch (SQLException e) {
                e.printStackTrace();
            }
        }

        return false;
    }
}
